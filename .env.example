# Copy to .env and fill in. Do not commit .env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com
# Comma-separate multiple recipients:
# MAIL_TO=you@gmail.com,partner@example.com

# Dual affidavit sweep (read-only HA listings + DE-111)
HA_URL=http://192.168.0.60:8123
HA_TOKEN=
# Never commit HA_TOKEN. The sweep never writes to HA or Follow Up Boss.
# TODO(v2): move FUB API key / Gmail app password / Sacramento portal
# password from the integration options into Home Assistant secrets.
